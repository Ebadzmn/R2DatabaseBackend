NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/movie_streaming_db

# Redis Connection (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_movie_upload_dashboard_2026_change_in_prod
JWT_EXPIRES_IN=7d

# AES-256-GCM Encryption Key (Must be 32 bytes / 64 hex characters or 32 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Public / CDN Streaming Base URL
STREAMING_BASE_URL=http://localhost:5000/stream

# Initial Admin Credentials (seeded on first boot if no admin exists)
INITIAL_ADMIN_EMAIL=admin@movieplatform.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME=Super Admin

# Optional custom FFmpeg paths (defaults to system PATH or @ffmpeg-installer)
FFMPEG_PATH=
FFPROBE_PATH=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
